# Cluster Visualizer Local Environment Configuration
# Copy this file to .env or .env.local to configure your local testbed and operator environments.

# Target execution host for ephemeral K3d testbed (e.g. localhost, or a remote SSH host)
CLUSTERVIS_TESTBED_HOST=localhost

# Tailscale or routable IP address for the testbed host
CLUSTERVIS_TESTBED_IP=127.0.0.1

# Path to remote binaries (k3d, docker) on the testbed host
CLUSTERVIS_REMOTE_BIN_DIR=~/.local/bin

# Multi-cluster comparison contexts (used by demo scripts and CLI)
CLUSTER_A_CONTEXT=cluster-alpha
CLUSTER_B_CONTEXT=cluster-beta

# In-cluster operator settings
CLUSTERVIS_REAL_MODE=0
CLUSTERVIS_EXPORT_INTERVAL_SECONDS=2.0
CLUSTERVIS_PROXY_SHARED_SECRET=
